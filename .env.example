# ==============================================================================
# MIRAGE 3.0: Production Environment Configuration Template (12-Factor App)
# Copy this file to .env for local testing or inject securely via Vault/SecretsManager.
# DO NOT commit .env files containing real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Global Controls
# ------------------------------------------------------------------------------
# Values: development, test, staging, production
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 2. Cryptographic Identity & JWT Signing
# ------------------------------------------------------------------------------
# In production, SECRET_KEY must be a unique, cryptographically random secret of at least 48 characters.
# Generate with: openssl rand -hex 32
SECRET_KEY=replace_with_min_48_char_random_secret_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_ISSUER=mirage-control-plane
JWT_AUDIENCE=mirage-gateway
# DEMO_AUTH_ENABLED must remain false in production (strictly prohibited)
DEMO_AUTH_ENABLED=false

# ------------------------------------------------------------------------------
# 3. External Tamper-Evident Audit Anchoring (Gate 5 & Compliance)
# ------------------------------------------------------------------------------
# Directory for immutable, append-only external anchor hash chains outside mutable DB rows
AUDIT_ANCHOR_DIR=data/audit_anchors
# Development notary keys are strictly prohibited in production mode
ALLOW_DEV_NOTARY_KEYS=false
# JSON mapping of signer_identity to authorized notary secret key (min 32 chars each)
# Example: {"notary:system_primary":"<32-byte-secret>","notary:secondary":"<32-byte-secret>"}
NOTARY_KEYS_JSON={"notary:system_primary":"replace_with_32_character_minimum_notary_secret_key"}

# ------------------------------------------------------------------------------
# 4. PostgreSQL Relational Database (Control Plane, Multi-Tenant RLS)
# ------------------------------------------------------------------------------
POSTGRES_DB=mirage_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# DDL Migration Owner (Used only by migration runner: 'mirage' superuser/owner)
POSTGRES_USER=mirage
POSTGRES_PASSWORD=replace_with_strong_database_admin_password

# Unprivileged Runtime Application Role (Used by Gateway & Worker: NOSUPERUSER, NOBYPASSRLS)
POSTGRES_APP_USER=mirage_app
POSTGRES_APP_PASSWORD=replace_with_strong_app_user_password

# Runtime Connection URLs (Gateway & Worker connect strictly as mirage_app)
DATABASE_URL=postgresql+asyncpg://mirage_app:replace_with_strong_app_user_password@postgres:5432/mirage_db
DATABASE_SYNC_URL=postgresql://mirage:replace_with_strong_database_admin_password@postgres:5432/mirage_db

# ------------------------------------------------------------------------------
# 5. MongoDB Document Store (Execution Traces & Payloads)
# ------------------------------------------------------------------------------
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=replace_with_strong_mongo_root_password
MONGO_APP_PASSWORD=replace_with_strong_mongo_app_password
MONGO_DB=mirage_traces
MONGO_URI=mongodb://mirage_app:replace_with_strong_mongo_app_password@mongodb:27017/mirage_traces?authSource=mirage_traces
MONGO_RETENTION_DAYS=90

# ------------------------------------------------------------------------------
# 6. Redis Cache & Distributed Rate Limiting
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=mirage_app
REDIS_PASSWORD=replace_with_strong_redis_password
REDIS_URL=redis://mirage_app:replace_with_strong_redis_password@redis:6379/0
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=2.0
REDIS_SOCKET_CONNECT_TIMEOUT=2.0
# Fail closed if Redis is unreachable in production
CIRCUIT_BREAKER_FAIL_CLOSED_ON_REDIS=true

# ------------------------------------------------------------------------------
# 7. RabbitMQ & Celery Asynchronous Workers
# ------------------------------------------------------------------------------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=mirage
RABBITMQ_PASSWORD=replace_with_strong_rabbitmq_password
CELERY_REDIS_USERNAME=mirage_celery
CELERY_REDIS_PASSWORD=replace_with_strong_celery_redis_password

# In production, AMQPS (TLS 1.2+) is mandatory per Security §4.1 and ADR 0003
CELERY_BROKER_URL=amqps://mirage:replace_with_strong_rabbitmq_password@rabbitmq.internal:5671//
CELERY_RESULT_BACKEND=redis://mirage_celery:replace_with_strong_celery_redis_password@redis:6379/1

# ------------------------------------------------------------------------------
# 8. Qdrant Vector Database (Gate 2 Context & Knowledge Base)
# ------------------------------------------------------------------------------
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=replace_with_strong_qdrant_api_key
QDRANT_HTTPS=false

# ------------------------------------------------------------------------------
# 9. Observability & Distributed Tracing (OpenTelemetry, Prometheus, Grafana)
# ------------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=mirage-gateway
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_with_strong_grafana_password

# ------------------------------------------------------------------------------
# 10. External Object Storage (Cold Evidence Bundles & Checkpoints, ADR 0005)
# ------------------------------------------------------------------------------
# Driver: local or s3
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=data/storage
S3_BUCKET_NAME=mirage-audit
S3_REGION_NAME=us-east-1
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ------------------------------------------------------------------------------
# 11. LLM Providers & Inference Configuration
# ------------------------------------------------------------------------------
# In production, mock providers are strictly prohibited
ALLOW_MOCK_PROVIDERS=false
DEFAULT_PRIMARY_MODEL=llama-3.3-70b-versatile
SCS_SAMPLE_COUNT=5
SCS_TEMPERATURE=0.7
CLIP_THRESHOLD=0.85
HRS_CORRECTION_THRESHOLD=0.60
MAX_CORRECTION_RETRIES=2

# Upstream Enterprise API Keys (Provide real credentials or configure per-tenant)
GROQ_API_KEY=
OPENROUTER_API_KEY=
HUGGINGFACE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 12. Stripe Payment Gateway (USD Global Billing & Subscriptions)
# Get keys from: Stripe Dashboard -> Developers -> API Keys (https://dashboard.stripe.com/apikeys)
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# ------------------------------------------------------------------------------
# 13. SMTP Email Delivery (Official Receipts, Tax Invoices & Alerts)
# Configurable with: Gmail SMTP (smtp.gmail.com), Resend (smtp.resend.com), SendGrid (smtp.sendgrid.net)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_char_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME="MIRAGE AI Execution Assurance"

