# ==============================================================================
# MIRAGE: Environment Configuration (12-Factor Settings Template)
# Copy this file to .env for local development
# ==============================================================================

# Application Environment (development, test, staging, production)
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# Security & JWT Authentication
SECRET_KEY=dev-insecure-secret-key-change-in-production-min32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL (Audit logs, tenant configurations, RLS)
POSTGRES_USER=mirage
POSTGRES_PASSWORD=mirage_dev_secret
POSTGRES_DB=mirage_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://mirage:mirage_dev_secret@localhost:5432/mirage_db
DATABASE_SYNC_URL=postgresql://mirage:mirage_dev_secret@localhost:5432/mirage_db

# MongoDB (Raw verification traces & execution spans)
MONGO_URI=mongodb://root:mirage_mongo_secret@localhost:27017
MONGO_DB=mirage_traces

# Redis (Prompt-hash caching, rate limiting counters)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=mirage_redis_secret
REDIS_URL=redis://:mirage_redis_secret@localhost:6379/0

# RabbitMQ (Task queue broker for Celery multi-signal workers)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=mirage
RABBITMQ_PASSWORD=mirage_rabbit_secret
CELERY_BROKER_URL=amqp://mirage:mirage_rabbit_secret@localhost:5672//
CELERY_RESULT_BACKEND=rpc://

# Qdrant Vector Database (RAV knowledge base storage)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# OpenTelemetry & Distributed Tracing
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=mirage-gateway

# External LLM Providers (Zero-cost free tiers)
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Verifier Model Parameters & Thresholds
DEFAULT_PRIMARY_MODEL=llama-3.1-70b-versatile
SCS_SAMPLE_COUNT=5
SCS_TEMPERATURE=0.7
CLIP_THRESHOLD=0.85
HRS_CORRECTION_THRESHOLD=0.60
MAX_CORRECTION_RETRIES=2
