# ==============================================================================
# Stage 1: Builder
# ==============================================================================
FROM python:3.12.5-slim-bookworm AS builder

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml .
RUN python -m venv /opt/venv && \
    /opt/venv/bin/pip install --no-cache-dir --upgrade pip && \
    /opt/venv/bin/pip install --no-cache-dir .

# ==============================================================================
# Stage 2: Runtime
# ==============================================================================
FROM python:3.12.5-slim-bookworm AS runner

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    procps \
    && rm -rf /var/lib/apt/lists/*

# Security: Run as non-root user (USER 1000:1000 per Security & Access §15)
RUN groupadd -g 1000 mirage && \
    useradd -u 1000 -g mirage -s /bin/bash -m mirage

COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

COPY . /app
RUN chown -R mirage:mirage /app

USER 1000:1000

HEALTHCHECK --interval=20s --timeout=5s --start-period=15s --retries=3 \
    CMD test $(expr $(date +%s) - $(stat -c %Y /tmp/worker_heartbeat 2>/dev/null || echo 0)) -lt 40 || exit 1

CMD ["celery", "-A", "workers.celery_app", "worker", "--loglevel=INFO", "-Q", "mirage.verify,mirage.drift,mirage.ingest", "--concurrency=2", "-n", "mirage_worker@%h"]
